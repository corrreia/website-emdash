{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "website-emdash",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],

	/**
	 * Wrangler creates any of these resources on first deploy if the configured
	 * name does not already exist, then reconnects to the same ones afterwards.
	 * Keep the names stable.
	 */
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "website-emdash",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "website-emdash-media",
		},
	],

	/**
	 * Object cache. Caches database query results in KV, a layer underneath the
	 * Worker, so repeat reads skip D1 entirely. Wired in astro.config.mjs as
	 * `objectCache: kvCache({ binding: "CACHE" })`.
	 *
	 * No `id` here on purpose: Wrangler provisions the namespace on first deploy
	 * and writes the id back, the same way it handles the D1 and R2 entries above.
	 */
	"kv_namespaces": [
		{
			"binding": "CACHE",
		},
	],

	/**
	 * Cloudflare AI Search, powering site search through the aiSearch() plugin.
	 *
	 * The namespace binding gives the runtime get/create access to every instance
	 * in the namespace; the plugin creates its own instance ("emdash-content") on
	 * first use. Every account already has a "default" namespace, so there is
	 * nothing to provision by hand.
	 *
	 * Note for local development: AI Search has no local emulator, so Miniflare
	 * opens a remote proxy session for this binding. `astro dev` therefore needs
	 * Cloudflare credentials (`wrangler login`, or CLOUDFLARE_API_TOKEN) while
	 * this is enabled.
	 *
	 * After deploying: open Cloudflare AI Search in the admin, choose the
	 * collections, and run Sync All Content. Hooks keep later edits in sync.
	 */
	"ai_search_namespaces": [{ "binding": "AI_SEARCH", "namespace": "default" }],

	/**
	 * Server-rendered pages make several D1 round trips per request, so run the
	 * Worker near the database rather than near the visitor.
	 */
	"placement": { "mode": "smart" },

	"routes": [
		{
			"pattern": "tomascorreia.net",
			"custom_domain": true,
		},
	],

	/**
	 * Cloudflare Email Sending, used by the cloudflareEmail() plugin in
	 * astro.config.mjs for magic-link sign-in and invitations. tomascorreia.net
	 * is onboarded as a sending domain.
	 */
	"send_email": [{ "name": "EMAIL" }],

	"observability": {
		"enabled": true,
	},

	// General maintenance cron trigger. Must match the expression passed to
	// createScheduledHandler({ generalCron }) in src/worker.ts.
	"triggers": {
		"crons": ["* * * * *"],
	},

	/**
	 * Not enabled, each needs something beyond a binding:
	 *
	 *   worker_loaders   Sandboxed plugins. Needs a Workers paid plan.
	 *                    "worker_loaders": [{ "binding": "LOADER" }]
	 *
	 *   images           Cloudflare Images as a media provider. Needs an Images
	 *                    subscription and a CF_IMAGES_TOKEN secret, then
	 *                    mediaProviders: [cloudflareImages({})].
	 */
}
