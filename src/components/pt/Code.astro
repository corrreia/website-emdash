---
/**
 * Portable Text `code` block renderer.
 *
 * Overrides EmDash's default so a fence tagged `mermaid` becomes a rendered
 * diagram instead of highlighted source. Everything else falls through to an
 * ordinary <pre><code>.
 *
 * `set:text` escapes the body, so mermaid label markup such as <br/> reaches
 * the client as text rather than being parsed into DOM nodes and lost. The
 * client script in posts/[slug].astro picks these elements up by class.
 *
 * Wire it up with:
 *   <PortableText value={...} components={{ type: { code: Code } }} />
 */

interface CodeNode {
	code?: string;
	language?: string;
	filename?: string;
}

const { node } = Astro.props as { node: CodeNode };

const source = node.code ?? "";
const language = node.language ?? "text";
const isDiagram = language === "mermaid";
---

{
	isDiagram ? (
		<figure class="mermaid-figure">
			<pre class="mermaid" role="img" aria-label={node.filename || "Diagram"} set:text={source} />
		</figure>
	) : (
		/* No whitespace between <pre> and <code>: a <pre> preserves it literally,
		   so template indentation would be rendered as leading blanks. */
		<pre class={`language-${language}`} data-language={language}><code set:text={source} /></pre>
	)
}
